{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RegionalInfrastructure",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*", "ec2:CreateVpc", "ec2:DeleteVpc", "ec2:ModifyVpcAttribute",
        "ec2:CreateSubnet", "ec2:DeleteSubnet", "ec2:ModifySubnetAttribute",
        "ec2:CreateRouteTable", "ec2:DeleteRouteTable", "ec2:AssociateRouteTable", "ec2:DisassociateRouteTable",
        "ec2:CreateRoute", "ec2:DeleteRoute", "ec2:ReplaceRoute",
        "ec2:CreateInternetGateway", "ec2:DeleteInternetGateway", "ec2:AttachInternetGateway", "ec2:DetachInternetGateway",
        "ec2:CreateNatGateway", "ec2:DeleteNatGateway", "ec2:AllocateAddress", "ec2:ReleaseAddress",
        "ec2:CreateSecurityGroup", "ec2:DeleteSecurityGroup", "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress", "ec2:AuthorizeSecurityGroupEgress", "ec2:RevokeSecurityGroupEgress",
        "ec2:CreateTags", "ec2:DeleteTags", "ec2:CreateSnapshot", "ec2:CreateVolume",
        "eks:CreateCluster", "eks:DescribeCluster", "eks:UpdateClusterConfig", "eks:UpdateClusterVersion", "eks:DeleteCluster",
        "eks:CreateNodegroup", "eks:DescribeNodegroup", "eks:UpdateNodegroupConfig", "eks:UpdateNodegroupVersion", "eks:DeleteNodegroup",
        "eks:CreateAddon", "eks:DescribeAddon", "eks:DescribeAddonVersions", "eks:UpdateAddon", "eks:DeleteAddon",
        "eks:CreatePodIdentityAssociation", "eks:DescribePodIdentityAssociation", "eks:UpdatePodIdentityAssociation", "eks:DeletePodIdentityAssociation",
        "eks:CreateAccessEntry", "eks:DescribeAccessEntry", "eks:UpdateAccessEntry", "eks:DeleteAccessEntry",
        "eks:AssociateAccessPolicy", "eks:DisassociateAccessPolicy", "eks:List*", "eks:DescribeUpdate", "eks:TagResource", "eks:UntagResource",
        "elasticloadbalancing:Describe*", "ecr:DescribeRepositories", "ecr:ListTagsForResource", "logs:DescribeLogGroups"
      ],
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "ap-southeast-2"}}
    },
    {
      "Sid": "ReadRuntimeImageMetadata",
      "Effect": "Allow",
      "Action": "ecr:DescribeImages",
      "Resource": [
        "arn:aws:ecr:ap-southeast-2:447061058131:repository/pd-spot-dev/pingdirectory",
        "arn:aws:ecr:ap-southeast-2:447061058131:repository/pd-spot-dev/pingdirectoryproxy",
        "arn:aws:ecr:ap-southeast-2:447061058131:repository/pd-spot-dev/pingfederate",
        "arn:aws:ecr:ap-southeast-2:447061058131:repository/pd-spot-dev/pingaccess"
      ]
    },
    {
      "Sid": "RuntimeIamOnly",
      "Effect": "Allow",
      "Action": ["iam:CreateRole", "iam:GetRole", "iam:UpdateRole", "iam:UpdateAssumeRolePolicy", "iam:DeleteRole",
        "iam:AttachRolePolicy", "iam:DetachRolePolicy", "iam:ListAttachedRolePolicies", "iam:ListRolePolicies",
        "iam:ListInstanceProfilesForRole", "iam:TagRole", "iam:UntagRole", "iam:ListRoleTags", "iam:PassRole",
        "iam:CreatePolicy", "iam:GetPolicy", "iam:GetPolicyVersion", "iam:CreatePolicyVersion", "iam:DeletePolicyVersion",
        "iam:DeletePolicy", "iam:ListPolicyVersions", "iam:TagPolicy", "iam:UntagPolicy", "iam:ListPolicyTags"],
      "Resource": ["arn:aws:iam::447061058131:role/pd-spot-dev-control-plane", "arn:aws:iam::447061058131:role/pd-spot-dev-nodes",
        "arn:aws:iam::447061058131:role/pd-spot-dev-ebs-csi", "arn:aws:iam::447061058131:role/pd-spot-dev-alb-controller",
        "arn:aws:iam::447061058131:policy/pd-spot-dev-alb-controller"]
    },
    {
      "Sid": "ClusterLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:DeleteLogGroup", "logs:DescribeLogGroups", "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy", "logs:TagResource", "logs:UntagResource", "logs:ListTagsForResource"],
      "Resource": ["arn:aws:logs:ap-southeast-2:447061058131:log-group:/aws/eks/pd-spot-dev/cluster", "arn:aws:logs:ap-southeast-2:447061058131:log-group:/aws/eks/pd-spot-dev/cluster:*"]
    },
    {
      "Sid": "EksServiceLinkedRoles",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::447061058131:role/aws-service-role/*",
      "Condition": {"StringEquals": {"iam:AWSServiceName": ["eks.amazonaws.com", "eks-nodegroup.amazonaws.com", "autoscaling.amazonaws.com"]}}
    },
    {
      "Sid": "PreserveDataAndFoundation",
      "Effect": "Deny",
      "Action": ["ec2:DeleteVolume", "ec2:DeleteSnapshot", "ecr:DeleteRepository", "kms:ScheduleKeyDeletion", "s3:DeleteBucket"],
      "Resource": "*"
    }
  ]
}
