region = "ap-southeast-2"
cluster_name = "pd-spot-dev"
kubernetes_version = "1.35"
availability_zones = ["ap-southeast-2a", "ap-southeast-2b", "ap-southeast-2c"]
admin_principal_arn = "arn:aws:iam::123456789012:role/YourDevelopmentRole"
api_public_access_cidrs = ["203.0.113.10/32"] # Replace with remote host egress IP.
spot_desired_per_az = 2
spot_max_per_az = 4
enable_on_demand = false
