# Adapted from Ping Identity baseline at 804766b0720d0bcdd2e0b0270b0e711d66e6f601.
# Resource/permission bootstrap only. Signed-token trust is installed after PF starts.
# This avoids requiring PF signing material before Directory can bootstrap.
dsconfig create-plugin --plugin-name pf-connected-identities --type composed-attribute --set enabled:true --set attribute-type:objectClass --set value-pattern:pf-connected-identities --set target-attribute-exists-during-initial-population-behavior:merge-existing-and-composed-values --set include-base-dn:${USER_BASE_DN} --set 'include-filter:(objectClass=inetOrgPerson)'
dsconfig create-plugin --plugin-name pf-connected-identity --type composed-attribute --set enabled:true --set attribute-type:pf-connected-identity --set 'value-pattern:auth-source=pf-local-identity:user-id={uid}' --set include-base-dn:${USER_BASE_DN} --set 'include-filter:(objectClass=inetOrgPerson)'
dsconfig create-rest-resource-type --type user --type-name platform-users --set display-name:Users --set enabled:true --set search-base-dn:ou=people,${USER_BASE_DN} --set primary-display-attribute-type:cn --set resource-endpoint:users --set 'search-filter-pattern:(|(cn=*%%*)(mail=%%*)(uid=%%*)(sn=*%%*))' --set structural-ldap-objectclass:inetOrgPerson --set parent-dn:ou=people,${USER_BASE_DN} --set create-rdn-attribute-type:uid
dsconfig create-rest-resource-type --type group --type-name platform-groups --set display-name:Groups --set enabled:true --set search-base-dn:ou=groups,${USER_BASE_DN} --set primary-display-attribute-type:cn --set resource-endpoint:groups --set 'search-filter-pattern:(cn=*%%*)' --set structural-ldap-objectclass:groupOfUniqueNames --set parent-dn:ou=groups,${USER_BASE_DN}
dsconfig create-delegated-admin-attribute --type-name platform-users --attribute-type cn --set 'display-name:Full Name'
dsconfig create-delegated-admin-attribute --type-name platform-users --attribute-type givenName --set 'display-name:First Name'
dsconfig create-delegated-admin-attribute --type-name platform-users --attribute-type sn --set 'display-name:Last Name'
dsconfig create-delegated-admin-attribute --type-name platform-users --attribute-type mail --set display-name:Email
dsconfig create-delegated-admin-attribute --type-name platform-users --attribute-type uid --set 'display-name:User ID'
dsconfig create-delegated-admin-attribute --type-name platform-groups --attribute-type cn --set display-name:Group
dsconfig create-delegated-admin-attribute --type-name platform-groups --attribute-type description --set display-name:Description
dsconfig create-delegated-admin-rights --rights-name platform-delegator --set enabled:true --set admin-user-dn:uid=administrator,ou=people,${USER_BASE_DN}
dsconfig create-delegated-admin-resource-rights --rights-name platform-delegator --rest-resource-type platform-users --set admin-scope:all-resources-in-base --set admin-permission:create --set admin-permission:read --set admin-permission:update --set admin-permission:delete --set admin-permission:manage-group-membership --set enabled:true
dsconfig create-delegated-admin-resource-rights --rights-name platform-delegator --rest-resource-type platform-groups --set admin-scope:all-resources-in-base --set admin-permission:create --set admin-permission:read --set admin-permission:update --set admin-permission:delete --set admin-permission:manage-group-membership --set enabled:true
dsconfig create-identity-mapper --mapper-name platform-entryUUID --type exact-match --set enabled:true --set match-attribute:entryUUID --set match-base-dn:ou=people,${USER_BASE_DN}
dsconfig set-access-control-handler-prop --add 'global-aci:(extop="1.3.6.1.4.1.30221.2.6.17 || 1.3.6.1.4.1.30221.2.6.62")(version 3.0;acl "Delegated Admin multi-update and generate-password"; allow (read) userdn="ldap:///all";)'
dsconfig set-access-control-handler-prop --add 'global-aci:(targetcontrol="1.3.6.1.4.1.4203.1.10.2 || 1.3.6.1.4.1.30221.2.5.40")(version 3.0;acl "Delegated Admin no-op and password validation details"; allow (read) userdn="ldap:///all";)'
dsconfig set-virtual-attribute-prop --name 'Delegated Admin Privilege' --set enabled:true
dsconfig set-http-servlet-extension-prop --extension-name 'Delegated Admin' --set access-token-scope:urn:pingidentity:directory-delegated-admin --set 'response-header:Cache-Control: no-cache, no-store, must-revalidate'
dsconfig create-delegated-admin-attribute --type-name platform-users --attribute-type ds-pwp-account-disabled --set "display-name:Account Disabled"
dsconfig set-http-servlet-extension-prop --extension-name "Delegated Admin" --add "response-header:Expires: 0" --add "response-header:Pragma: no-cache"
